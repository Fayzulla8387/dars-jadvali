rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /dars/jadval {
      allow read: if true;
      // faqat admin (Authentication'da yaratilgan email) yozishi mumkin:
      allow write: if request.auth != null && request.auth.token.email == "ADMIN_EMAIL@example.com";
    }
  }
}
